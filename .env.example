# Server for REMOTE.sh.  Copy this file to .env and fill it in; .env is not committed.
# Quote values with single quotes, especially a password with special characters.

REMOTE_HOST='server.example.edu'
REMOTE_USER='your-username'
REMOTE_PORT=22

# Leave empty to use your SSH keys or agent instead.  A password needs sshpass
# locally: brew install sshpass
REMOTE_PASSWORD=''

# Project folder on the server; a relative path is under your home folder.
REMOTE_DIR='cse561-project'

# How many simulations run at once.  Check memory first: see each run's resources.log.
REMOTE_JOBS=4

# Optional commands run before each remote command, for example to load modules:
# REMOTE_SETUP='module load cmake gcc python'
REMOTE_SETUP=''
